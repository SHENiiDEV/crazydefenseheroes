APP_NAME="Crazy Defense Heroes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1

# Company details used by legal pages, receipts and PDF invoices.
COMPANY_NAME="Your Company Name"
COMPANY_NUMBER="Your registration number"
COMPANY_ADDRESS="Your registered address"
COMPANY_EMAIL="info@yourdomain.com"

# Namecheap Private Email SMTP (configure in Laravel mail.php).
MAIL_MAILER=smtp
MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_USERNAME=info@yourdomain.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"
