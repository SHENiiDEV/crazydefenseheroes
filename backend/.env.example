APP_NAME="Crazy Defense Heroes"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:6767,http://127.0.0.1:6767
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-Request-Id,Idempotency-Key,X-Payment-Signature

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_AFTER_COMMIT=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.privateemail.com
MAIL_PORT=587
MAIL_USERNAME=info@crazydefenseheroes.co.uk
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@crazydefenseheroes.co.uk
MAIL_FROM_NAME="${APP_NAME}"

# Company details used by legal pages, receipts and PDF invoices.
COMAPANY_NAME="Crazy Defense Heroes Ltd"
COMPANY_NAME="Crazy Defense Heroes Ltd"
COMAPNY_NUMBER="14892341"
COMPANY_NUMBER="14892341"
COMPANY_ADDRESS="71-75 Shelton Street, Covent Garden, London, WC2H 9JQ, United Kingdom"
COMPANY_EMAIL="info@crazydefenseheroes.co.uk"
COMPANY_DOMAIN="crazydefenseheroes.co.uk"

INVOICE_NUMBER_PREFIX=CDH-
INVOICE_CURRENCY=EUR
INVOICE_LOCALE=en_GB
INVOICE_STORAGE_DISK=local

PAYMENTS_PROVIDER=sandbox
PAYMENTS_WEBHOOK_SECRET=change-this-before-production

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
